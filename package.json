{
  "name": "villagio-farmer",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "cmd /c \"start cmd /k npm run dev --workspace=apps/api && start cmd /k npm run dev --workspace=apps/web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "install:all": "npm install",
    "seed": "npm run seed --workspace=apps/api"
  }
}
